/* =========================================================
   PERSONAL COURSE STUDIO
   MENTOR STUDIO — PREMIUM DARK UI
   File: mentor/style.css
   ========================================================= */


/* =========================================================
   ROOT
   ========================================================= */

:root {

  --bg:
    #050912;

  --bg-soft:
    #09111f;

  --panel:
    #0c1524;

  --panel-2:
    #101b2d;

  --panel-3:
    #132238;

  --border:
    rgba(255, 255, 255, 0.08);

  --border-strong:
    rgba(255, 255, 255, 0.14);

  --text:
    #f5f8ff;

  --text-soft:
    #a9b5c7;

  --text-muted:
    #718096;

  --blue:
    #4da3ff;

  --blue-strong:
    #1677e8;

  --blue-soft:
    rgba(77, 163, 255, 0.12);

  --cyan:
    #4de7ff;

  --green:
    #35d39a;

  --yellow:
    #f4c95d;

  --red:
    #ff5c70;

  --purple:
    #9b7cff;

  --shadow:
    0 20px 60px rgba(0, 0, 0, 0.35);

  --shadow-soft:
    0 10px 35px rgba(0, 0, 0, 0.22);

  --radius:
    16px;

  --radius-sm:
    10px;

  --topbar-height:
    74px;

  --sidebar-width:
    350px;

  --transition:
    180ms ease;

}


/* =========================================================
   RESET
   ========================================================= */

* {
  box-sizing: border-box;
}

html {
  width: 100%;
  min-height: 100%;
  background: var(--bg);
  color-scheme: dark;
}

body {
  width: 100%;
  min-height: 100vh;
  margin: 0;

  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(32, 100, 180, 0.12),
      transparent 30%
    ),
    radial-gradient(
      circle at 90% 0%,
      rgba(120, 70, 200, 0.08),
      transparent 25%
    ),
    var(--bg);

  color: var(--text);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  overflow-x: hidden;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  border: 0;
}

button,
select,
input[type="range"],
input[type="checkbox"],
input[type="color"] {
  cursor: pointer;
}

img,
video,
canvas {
  display: block;
}

img {
  max-width: 100%;
}

video {
  background: #000;
}

::selection {
  background: rgba(77, 163, 255, 0.3);
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

* {
  scrollbar-width: thin;
  scrollbar-color:
    rgba(255, 255, 255, 0.14)
    transparent;
}

*::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  background:
    rgba(255, 255, 255, 0.13);

  border-radius: 999px;
}

*::-webkit-scrollbar-thumb:hover {
  background:
    rgba(255, 255, 255, 0.22);
}


/* =========================================================
   APP
   ========================================================= */

.app {
  width: 100%;
  min-height: 100vh;
}


/* =========================================================
   TOP BAR
   ========================================================= */

.topbar {
  position: sticky;
  top: 0;
  z-index: 1000;

  min-height: var(--topbar-height);

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 24px;

  padding:
    12px 20px;

  background:
    rgba(5, 9, 18, 0.88);

  border-bottom:
    1px solid var(--border);

  backdrop-filter:
    blur(22px);

  -webkit-backdrop-filter:
    blur(22px);
}


/* =========================================================
   BRAND
   ========================================================= */

.brand-area {
  display: flex;
  align-items: center;
  gap: 12px;

  min-width: 210px;
}

.brand-mark {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #1677e8,
      #4de7ff
    );

  color: #fff;

  box-shadow:
    0 10px 30px
    rgba(22, 119, 232, 0.3);
}

.brand-mark span {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.06em;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.brand-copy strong {
  font-size: 15px;
  font-weight: 800;
}

.brand-copy span {
  color: var(--text-muted);
  font-size: 11px;
}


/* =========================================================
   TOPBAR ACTIONS
   ========================================================= */

.topbar-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;

  gap: 8px;

  flex-wrap: wrap;
}

.topbar-btn,
.record-main-btn {
  min-height: 40px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  padding:
    0 13px;

  border-radius: 10px;

  color: var(--text-soft);

  background:
    rgba(255, 255, 255, 0.045);

  border:
    1px solid var(--border);

  transition:
    transform var(--transition),
    background var(--transition),
    border-color var(--transition),
    color var(--transition);
}

.topbar-btn:hover {
  color: var(--text);
  background:
    rgba(255, 255, 255, 0.08);

  border-color:
    var(--border-strong);

  transform:
    translateY(-1px);
}

.record-main-btn {
  color: #fff;

  background:
    linear-gradient(
      135deg,
      #e72e4a,
      #ff5268
    );

  border-color:
    rgba(255, 255, 255, 0.08);

  box-shadow:
    0 10px 25px
    rgba(255, 55, 85, 0.18);
}

.record-main-btn:hover {
  transform:
    translateY(-1px);

  box-shadow:
    0 14px 30px
    rgba(255, 55, 85, 0.28);
}

.record-dot {
  width: 9px;
  height: 9px;

  display: inline-block;

  border-radius: 50%;

  background: currentColor;
}


/* =========================================================
   RECORDING STATUS BAR
   ========================================================= */

.recording-status-bar {
  position: sticky;
  top: var(--topbar-height);
  z-index: 900;

  min-height: 42px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 16px;

  padding:
    7px 20px;

  background:
    rgba(10, 18, 31, 0.95);

  border-bottom:
    1px solid var(--border);

  box-shadow:
    0 8px 25px
    rgba(0, 0, 0, 0.14);
}

.recording-status-left,
.recording-status-center,
.recording-status-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.recording-status-left {
  min-width: 180px;
}

.recording-status-left strong {
  font-size: 12px;
}

.recording-status-center {
  color: var(--text-muted);
  font-size: 11px;
}

.recording-status-center strong {
  color: var(--text-soft);
}

.recording-status-right {
  justify-content: flex-end;
}

.recording-status-dot {
  width: 8px;
  height: 8px;

  border-radius: 50%;

  background: var(--text-muted);
}

.recording-timer {
  min-width: 72px;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 12px;
  color: var(--text-soft);
}

.status-indicator {
  display: inline-flex;
  align-items: center;

  min-height: 25px;

  padding:
    0 8px;

  border-radius: 999px;

  background:
    rgba(255, 255, 255, 0.04);

  border:
    1px solid var(--border);

  color: var(--text-muted);

  font-size: 10px;
}

.mini-control {
  min-height: 28px;

  padding:
    0 9px;

  border-radius: 7px;

  background:
    rgba(255, 255, 255, 0.05);

  border:
    1px solid var(--border);

  color: var(--text-soft);

  font-size: 10px;
}

.mini-control:hover {
  color: var(--text);
  background:
    rgba(255, 255, 255, 0.09);
}

.mini-control.danger {
  color: #ff8090;
}


/* =========================================================
   WORKSPACE
   ========================================================= */

.workspace {
  width: 100%;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    var(--sidebar-width);

  gap: 18px;

  padding:
    18px 18px 30px;
}


/* =========================================================
   STAGE AREA
   ========================================================= */

.stage-area {
  min-width: 0;
}

.stage-shell {
  width: 100%;
  max-width: 1920px;

  margin:
    0 auto;

  border-radius:
    var(--radius);

  background:
    #02050a;

  box-shadow:
    var(--shadow);

  overflow: hidden;
}


/* =========================================================
   STAGE
   ========================================================= */

.stage {
  position: relative;

  width: 100%;

  aspect-ratio:
    16 / 9;

  overflow: hidden;

  background:
    #000;

  isolation: isolate;
}


/* =========================================================
   MAIN MEDIA
   ========================================================= */

#mainImage,
#mainVideo,
#screenCaptureVideo {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: contain;

  background:
    #000;
}

#mainImage {
  z-index: 1;

  display: none;
}

#mainVideo {
  z-index: 2;

  display: none;
}

#screenCaptureVideo {
  z-index: 3;

  display: none;

  object-fit: contain;
}


/* =========================================================
   WELCOME CONTENT
   ========================================================= */

.welcome-content {
  position: absolute;

  inset: 0;

  z-index: 8;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  padding: 30px;

  text-align: center;

  background:
    radial-gradient(
      circle at center,
      rgba(26, 75, 130, 0.2),
      transparent 50%
    );
}

.welcome-icon {
  width: 70px;
  height: 70px;

  display: grid;
  place-items: center;

  margin-bottom: 18px;

  border-radius: 22px;

  background:
    linear-gradient(
      135deg,
      rgba(77, 163, 255, 0.18),
      rgba(77, 231, 255, 0.08)
    );

  border:
    1px solid
    rgba(77, 163, 255, 0.2);

  color: var(--blue);

  font-size: 30px;
}

.welcome-content h1 {
  margin:
    0 0 8px;

  font-size:
    clamp(24px, 3vw, 40px);

  letter-spacing:
    -0.03em;
}

.welcome-content p {
  max-width: 520px;

  margin:
    0 0 22px;

  color: var(--text-muted);

  line-height: 1.6;
}


/* =========================================================
   MENTOR CARD
   ========================================================= */

.mentor-card {
  position: absolute;

  z-index: 30;

  right: 3%;
  bottom: 4%;

  width: 22%;

  max-width: 45%;
  min-width: 130px;

  aspect-ratio:
    16 / 9;

  min-height: 73px;

  overflow: hidden;

  border-radius: 13px;

  background:
    #0a101a;

  border:
    1px solid
    rgba(255, 255, 255, 0.14);

  box-shadow:
    0 18px 50px
    rgba(0, 0, 0, 0.42);

  touch-action: none;

  user-select: none;
}

.mentor-card video,
.mentor-card canvas {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  border-radius: inherit;
}

#mentorVideo {
  z-index: 1;

  display: none;
}

#mentorCameraVideo {
  z-index: 2;

  display: none;

  transform:
    scaleX(-1);
}

#mentorAICanvas {
  z-index: 3;

  display: none;
}

.mentor-placeholder {
  position: absolute;

  inset: 0;

  z-index: 5;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 8px;

  color: var(--text-muted);

  background:
    linear-gradient(
      135deg,
      #0b1421,
      #07101c
    );
}

.mentor-placeholder-icon {
  width: 36px;
  height: 36px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background:
    rgba(255, 255, 255, 0.06);

  color: var(--text-soft);

  font-size: 17px;
}

.mentor-placeholder span {
  font-size: 10px;
}

.mentor-source-label {
  position: absolute;

  left: 8px;
  top: 8px;

  z-index: 20;

  min-height: 21px;

  display: inline-flex;
  align-items: center;

  padding:
    0 7px;

  border-radius: 6px;

  background:
    rgba(0, 0, 0, 0.52);

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  color: #fff;

  font-size: 8px;
  font-weight: 800;

  letter-spacing:
    0.08em;
}

.mentor-resize {
  position: absolute;

  right: 0;
  bottom: 0;

  z-index: 50;

  width: 24px;
  height: 24px;

  cursor:
    nwse-resize;

  background:
    linear-gradient(
      135deg,
      transparent 0 45%,
      rgba(255, 255, 255, 0.7) 46% 52%,
      transparent 53%
    );

  opacity: 0.75;
}

.mentor-card:hover .mentor-resize {
  opacity: 1;
}


/* =========================================================
   BRAND BADGE
   ========================================================= */

.brand-badge {
  position: absolute;

  z-index: 35;

  left: 2.5%;
  bottom: 3.5%;

  display: inline-flex;
  align-items: center;

  gap: 8px;

  max-width: 45%;

  padding:
    8px 11px;

  border-radius: 8px;

  background:
    rgba(4, 8, 14, 0.72);

  border:
    1px solid
    rgba(255, 255, 255, 0.1);

  color: rgba(255, 255, 255, 0.9);

  font-size: 10px;

  backdrop-filter:
    blur(10px);
}

.brand-badge-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background:
    var(--blue);
}


/* =========================================================
   RECORDING OVERLAY
   ========================================================= */

.recording-overlay {
  position: absolute;

  top: 3%;
  left: 3%;

  z-index: 100;

  display: none;
  align-items: center;

  gap: 8px;

  padding:
    8px 11px;

  border-radius: 8px;

  background:
    rgba(190, 15, 36, 0.78);

  color: #fff;

  font-size: 10px;
  font-weight: 800;

  letter-spacing:
    0.04em;

  box-shadow:
    0 8px 25px
    rgba(0, 0, 0, 0.25);
}

.recording-overlay-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #fff;

  animation:
    recordingPulse 1s infinite;
}

.recording-overlay strong {
  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;
}


/* =========================================================
   STAGE BADGES
   ========================================================= */

.stage-badges {
  position: absolute;

  top: 3%;
  right: 2.5%;

  z-index: 40;

  display: flex;
  align-items: center;

  gap: 6px;
}

.stage-badge {
  min-height: 22px;

  display: inline-flex;
  align-items: center;

  padding:
    0 7px;

  border-radius: 6px;

  background:
    rgba(0, 0, 0, 0.52);

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  color:
    rgba(255, 255, 255, 0.78);

  font-size: 8px;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;
}


/* =========================================================
   MAIN TOOLBAR
   ========================================================= */

.main-toolbar {
  min-height: 62px;

  display: flex;
  align-items: center;

  justify-content: space-between;

  gap: 12px;

  padding:
    10px 12px;

  background:
    rgba(10, 17, 29, 0.95);

  border-top:
    1px solid var(--border);
}

.toolbar-group {
  display: flex;
  align-items: center;

  gap: 7px;

  flex-wrap: wrap;
}

.toolbar-right {
  margin-left: auto;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.tool-btn,
.side-btn,
.file-btn,
.primary-btn,
.secondary-btn,
.danger-btn,
.small-add-btn {
  min-height: 38px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 7px;

  padding:
    0 12px;

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.045);

  border:
    1px solid var(--border);

  color: var(--text-soft);

  transition:
    transform var(--transition),
    background var(--transition),
    border-color var(--transition),
    color var(--transition),
    box-shadow var(--transition);
}

.tool-btn:hover,
.side-btn:hover,
.file-btn:hover,
.secondary-btn:hover {
  color: var(--text);

  background:
    rgba(255, 255, 255, 0.08);

  border-color:
    var(--border-strong);

  transform:
    translateY(-1px);
}

.tool-btn.primary,
.primary-btn {
  color: #fff;

  background:
    linear-gradient(
      135deg,
      #1677e8,
      #278eea
    );

  border-color:
    rgba(255, 255, 255, 0.05);

  box-shadow:
    0 8px 22px
    rgba(22, 119, 232, 0.16);
}

.tool-btn.primary:hover,
.primary-btn:hover {
  background:
    linear-gradient(
      135deg,
      #1d83f4,
      #35a0f5
    );

  box-shadow:
    0 10px 28px
    rgba(22, 119, 232, 0.25);
}

.tool-btn.danger,
.danger-btn {
  color: #ff9baa;

  background:
    rgba(255, 66, 90, 0.08);

  border-color:
    rgba(255, 66, 90, 0.18);
}

.danger-btn {
  color: #fff;

  background:
    rgba(224, 46, 69, 0.85);
}

.danger-btn:hover {
  background:
    rgba(240, 50, 75, 0.95);
}


/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 12px;

  max-height:
    calc(
      100vh -
      var(--topbar-height) -
      42px -
      36px
    );

  overflow-y: auto;

  padding-right: 2px;
}


/* =========================================================
   SIDE CARD
   ========================================================= */

.side-card {
  padding:
    14px;

  border-radius:
    var(--radius);

  background:
    linear-gradient(
      180deg,
      rgba(16, 27, 45, 0.96),
      rgba(10, 19, 32, 0.96)
    );

  border:
    1px solid var(--border);

  box-shadow:
    var(--shadow-soft);
}

.side-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 12px;

  margin-bottom: 13px;
}

.side-card-header h3 {
  margin: 0 0 3px;

  font-size: 13px;
  font-weight: 800;
}

.side-card-header span {
  color: var(--text-muted);

  font-size: 10px;
  line-height: 1.4;
}

.side-status {
  flex-shrink: 0;

  padding:
    5px 7px;

  border-radius: 6px;

  background:
    rgba(255, 255, 255, 0.04);

  color: var(--text-muted);

  font-size: 9px;
}


/* =========================================================
   SIDE ACTIONS
   ========================================================= */

.side-actions {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 7px;
}

.side-btn {
  width: 100%;

  min-height: 34px;

  padding:
    0 8px;

  font-size: 10px;
}

.side-btn.primary {
  color: #fff;

  background:
    rgba(22, 119, 232, 0.9);

  border-color:
    rgba(77, 163, 255, 0.3);
}


/* =========================================================
   FORM
   ========================================================= */

.form-group {
  display: flex;
  flex-direction: column;

  gap: 6px;

  margin-top: 11px;
}

.form-group label {
  color: var(--text-soft);

  font-size: 10px;
  font-weight: 600;
}

.form-row {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 9px;
}

.form-row .form-group {
  min-width: 0;
}

input[type="text"],
input[type="number"],
input[type="email"],
input[type="password"],
select,
textarea {
  width: 100%;

  border:
    1px solid var(--border);

  outline: none;

  border-radius: 9px;

  background:
    rgba(0, 0, 0, 0.18);

  color: var(--text);

  transition:
    border-color var(--transition),
    box-shadow var(--transition),
    background var(--transition);
}

input[type="text"],
input[type="number"],
input[type="email"],
input[type="password"],
select {
  min-height: 36px;

  padding:
    0 10px;

  font-size: 11px;
}

select {
  appearance: auto;
}

textarea {
  min-height: 180px;

  padding:
    12px;

  resize: vertical;

  line-height: 1.6;

  font-size: 13px;
}

input:focus,
select:focus,
textarea:focus {
  border-color:
    rgba(77, 163, 255, 0.45);

  box-shadow:
    0 0 0 3px
    rgba(77, 163, 255, 0.08);

  background:
    rgba(0, 0, 0, 0.24);
}

input[type="color"] {
  width: 100%;
  height: 38px;

  padding: 3px;

  border:
    1px solid var(--border);

  border-radius: 9px;

  background:
    rgba(0, 0, 0, 0.2);
}


/* =========================================================
   CHECKBOX
   ========================================================= */

.check-row {
  margin-top: 10px;
}

.check-label {
  display: flex;

  align-items: center;

  gap: 8px;

  color: var(--text-soft);

  font-size: 10px;

  cursor: pointer;
}

.check-label input {
  width: 15px;
  height: 15px;

  accent-color:
    var(--blue);
}


/* =========================================================
   RANGE
   ========================================================= */

.range-group {
  margin-top: 12px;
}

.range-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 6px;
}

.range-header label {
  color: var(--text-soft);

  font-size: 10px;
}

.range-header span {
  color: var(--text-muted);

  font-size: 9px;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;
}

input[type="range"] {
  width: 100%;

  height: 4px;

  margin: 0;

  accent-color:
    var(--blue);
}


/* =========================================================
   AI BACKGROUND GRID
   ========================================================= */

.background-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 7px;
}

.bg-btn {
  min-height: 36px;

  display: flex;

  align-items: center;
  justify-content: center;

  gap: 6px;

  border-radius: 8px;

  background:
    rgba(255, 255, 255, 0.035);

  border:
    1px solid var(--border);

  color: var(--text-muted);

  font-size: 10px;

  transition:
    all var(--transition);
}

.bg-btn:hover {
  color: var(--text);

  background:
    rgba(255, 255, 255, 0.07);
}

.bg-btn.active {
  color: #fff;

  background:
    rgba(22, 119, 232, 0.18);

  border-color:
    rgba(77, 163, 255, 0.3);

  box-shadow:
    inset 0 0 0 1px
    rgba(77, 163, 255, 0.04);
}

.bg-btn span {
  color: var(--blue);
}

.background-upload-box {
  margin-top: 11px;

  padding:
    11px;

  border-radius: 10px;

  border:
    1px dashed
    rgba(255, 255, 255, 0.12);

  background:
    rgba(255, 255, 255, 0.02);
}

.background-upload-box strong {
  display: block;

  margin-bottom: 3px;

  font-size: 10px;
}

.background-upload-box span {
  display: block;

  margin-bottom: 9px;

  color: var(--text-muted);

  font-size: 9px;

  line-height: 1.5;
}


/* =========================================================
   SCREEN CAPTURE
   ========================================================= */

.screen-status {
  display: flex;
  align-items: center;

  gap: 7px;

  padding:
    8px 9px;

  border-radius: 8px;

  background:
    rgba(255, 255, 255, 0.025);

  color: var(--text-muted);

  font-size: 9px;
}

.screen-status-light {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background:
    var(--text-muted);
}

.screen-status-light.active {
  background:
    var(--green);

  box-shadow:
    0 0 10px
    rgba(53, 211, 154, 0.45);
}


/* =========================================================
   AUDIO METERS
   ========================================================= */

.meter-group {
  margin-top: 12px;
}

.meter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 6px;

  color: var(--text-muted);

  font-size: 9px;
}

.meter-header strong {
  color: var(--text-soft);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;
}

.audio-meter {
  width: 100%;
  height: 6px;

  overflow: hidden;

  border-radius: 999px;

  background:
    rgba(255, 255, 255, 0.06);
}

.audio-meter-fill {
  width: 0%;
  height: 100%;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      #35d39a,
      #f4c95d,
      #ff5c70
    );

  transition:
    width 60ms linear;
}

.waveform-box {
  width: 100%;

  margin-top: 12px;

  padding: 7px;

  border-radius: 9px;

  background:
    rgba(0, 0, 0, 0.2);

  border:
    1px solid var(--border);

  overflow: hidden;
}

#micWaveformCanvas {
  width: 100%;
  height: 65px;

  border-radius: 6px;

  background:
    rgba(255, 255, 255, 0.015);
}


/* =========================================================
   TELEPROMPTER MINI
   ========================================================= */

.teleprompter-mini-preview {
  position: relative;

  height: 105px;

  overflow: hidden;

  border-radius: 10px;

  background:
    #05080d;

  border:
    1px solid var(--border);
}

.teleprompter-mini-content {
  padding:
    18px;

  color:
    rgba(255, 255, 255, 0.82);

  font-size: 12px;

  line-height: 1.7;
}


/* =========================================================
   STUDENTS
   ========================================================= */

.small-add-btn {
  width: 30px;
  min-height: 30px;

  padding: 0;

  border-radius: 8px;

  color: #fff;

  background:
    rgba(22, 119, 232, 0.2);

  border-color:
    rgba(77, 163, 255, 0.25);

  font-size: 18px;
}

.students-list {
  display: flex;
  flex-direction: column;

  gap: 7px;
}

.student-item {
  min-height: 38px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 8px;

  padding:
    6px 8px;

  border-radius: 8px;

  background:
    rgba(255, 255, 255, 0.035);

  border:
    1px solid var(--border);
}

.student-info {
  display: flex;
  align-items: center;

  gap: 8px;

  min-width: 0;
}

.student-avatar {
  width: 26px;
  height: 26px;

  flex-shrink: 0;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background:
    rgba(77, 163, 255, 0.14);

  color: var(--blue);

  font-size: 10px;
  font-weight: 800;
}

.student-name {
  overflow: hidden;

  white-space: nowrap;

  text-overflow: ellipsis;

  color: var(--text-soft);

  font-size: 10px;
}

.student-remove {
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  border-radius: 7px;

  background:
    transparent;

  color: var(--text-muted);

  cursor: pointer;
}

.student-remove:hover {
  color: var(--red);

  background:
    rgba(255, 92, 112, 0.08);
}


/* =========================================================
   FILE BUTTONS
   ========================================================= */

.file-buttons {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 7px;
}

.file-btn {
  min-height: 46px;

  flex-direction: column;

  gap: 4px;

  padding:
    7px;

  font-size: 9px;
}

.file-btn span {
  color: var(--blue);

  font-size: 15px;
}


/* =========================================================
   MODAL
   ========================================================= */

.modal {
  position: fixed;

  inset: 0;

  z-index: 5000;

  display: none;

  align-items: center;
  justify-content: center;

  padding:
    20px;
}

.modal.open {
  display: flex;
}

.modal-backdrop {
  position: absolute;

  inset: 0;

  background:
    rgba(0, 0, 0, 0.72);

  backdrop-filter:
    blur(12px);

  -webkit-backdrop-filter:
    blur(12px);
}

.modal-panel {
  position: relative;

  z-index: 2;

  width: min(
    760px,
    100%
  );

  max-height:
    calc(100vh - 40px);

  overflow-y: auto;

  border-radius:
    18px;

  background:
    linear-gradient(
      180deg,
      #101c2d,
      #09111e
    );

  border:
    1px solid var(--border-strong);

  box-shadow:
    0 30px 100px
    rgba(0, 0, 0, 0.58);

  animation:
    modalIn 180ms ease;
}

.modal-panel.small {
  width: min(
    480px,
    100%
  );
}

.modal-header {
  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  padding:
    20px 20px 15px;

  border-bottom:
    1px solid var(--border);
}

.modal-header h2 {
  margin: 0 0 5px;

  font-size: 18px;
}

.modal-header p {
  margin: 0;

  color: var(--text-muted);

  font-size: 11px;
}

.modal-close {
  width: 34px;
  height: 34px;

  flex-shrink: 0;

  display: grid;
  place-items: center;

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.05);

  color: var(--text-soft);

  border:
    1px solid var(--border);

  font-size: 20px;

  cursor: pointer;
}

.modal-close:hover {
  color: #fff;

  background:
    rgba(255, 255, 255, 0.09);
}

.modal-body {
  padding:
    20px;
}

.modal-footer {
  display: flex;

  justify-content: flex-end;

  align-items: center;

  gap: 8px;

  padding:
    14px 20px;

  border-top:
    1px solid var(--border);
}


/* =========================================================
   SHORTCUTS
   ========================================================= */

.shortcut-list {
  padding:
    10px 20px 20px;
}

.shortcut-row {
  min-height: 45px;

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 15px;

  border-bottom:
    1px solid var(--border);

  color: var(--text-soft);

  font-size: 11px;
}

.shortcut-row:last-child {
  border-bottom: 0;
}

kbd {
  min-width: 34px;

  display: inline-flex;
  justify-content: center;

  padding:
    5px 8px;

  border-radius: 6px;

  background:
    rgba(255, 255, 255, 0.06);

  border:
    1px solid var(--border);

  color: var(--text);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;

  font-size: 10px;
}


/* =========================================================
   TELEPROMPTER MODAL
   ========================================================= */

.teleprompter-panel {
  width:
    min(
      1200px,
      100%
    );
}

.teleprompter-editor {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  gap: 12px;

  padding:
    18px 20px 0;
}

.teleprompter-editor textarea {
  min-height: 360px;
}

.teleprompter-preview-wrap {
  min-width: 0;

  border-radius: 12px;

  overflow: hidden;

  border:
    1px solid var(--border);

  background:
    #020406;
}

.teleprompter-preview-header {
  min-height: 36px;

  display: flex;
  align-items: center;

  padding:
    0 11px;

  border-bottom:
    1px solid var(--border);

  color: var(--text-muted);

  font-size: 10px;
}

.teleprompter-preview {
  position: relative;

  height: 360px;

  overflow: hidden;

  padding:
    40px 28px;

  background:
    #000;

  color: #fff;

  font-size: 38px;

  line-height: 1.7;
}

.teleprompter-preview-text {
  white-space: pre-wrap;

  text-align: center;
}

.teleprompter-controls {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 12px;

  padding:
    18px 20px;
}


/* =========================================================
   RECORDING PREVIEW
   ========================================================= */

.recording-preview-panel {
  width:
    min(
      1300px,
      100%
    );
}

.recording-preview-layout {
  display: grid;

  grid-template-columns:
    minmax(0, 1.5fr)
    minmax(300px, 0.8fr);

  gap: 16px;

  padding:
    18px 20px;
}

.recording-preview-video-wrap {
  position: relative;

  min-width: 0;

  aspect-ratio:
    16 / 9;

  overflow: hidden;

  border-radius: 12px;

  background:
    #000;

  border:
    1px solid var(--border);
}

#recordingPreviewVideo {
  width: 100%;
  height: 100%;

  object-fit: contain;

  background:
    #000;
}

.preview-video-overlay {
  position: absolute;

  right: 10px;
  bottom: 10px;

  display: flex;
  gap: 4px;

  padding:
    6px 8px;

  border-radius: 7px;

  background:
    rgba(0, 0, 0, 0.65);

  color: #fff;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;

  font-size: 9px;
}

.recording-info-panel {
  min-width: 0;
}

.recording-file-info {
  min-height: 52px;

  padding:
    10px;

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.035);

  border:
    1px solid var(--border);

  color: var(--text-muted);

  font-size: 10px;

  line-height: 1.6;
}

.preview-controls {
  display: flex;

  gap: 7px;

  margin-top: 10px;
}

.preview-controls button {
  flex: 1;
}

.trim-box {
  margin-top: 12px;

  padding:
    11px;

  border-radius: 10px;

  background:
    rgba(255, 255, 255, 0.025);

  border:
    1px solid var(--border);
}

.trim-header {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 10px;

  margin-bottom: 8px;
}

.trim-header strong {
  font-size: 11px;
}

.trim-header span {
  color: var(--text-muted);

  font-size: 9px;
}

.trim-range {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 10px;
}

.trim-range .form-group {
  margin-top: 0;
}

.trim-range .form-group > span {
  color: var(--text-muted);

  font-size: 9px;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;
}

.trim-actions {
  display: flex;

  gap: 7px;

  margin-top: 10px;
}

.trim-actions button {
  flex: 1;
}

.recording-main-actions {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 7px;

  margin-top: 12px;
}


/* =========================================================
   RECORDING HISTORY
   ========================================================= */

.recording-history {
  margin:
    0 20px 20px;

  padding-top:
    18px;

  border-top:
    1px solid var(--border);
}

.history-header {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 10px;
}

.history-header h3 {
  margin: 0 0 3px;

  font-size: 13px;
}

.history-header span {
  color: var(--text-muted);

  font-size: 9px;
}

.recording-history-list {
  display: flex;

  flex-direction: column;

  gap: 7px;
}

.history-item {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    auto;

  align-items: center;

  gap: 12px;

  padding:
    9px 10px;

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.03);

  border:
    1px solid var(--border);
}

.history-main {
  min-width: 0;
}

.history-name {
  overflow: hidden;

  text-overflow: ellipsis;
  white-space: nowrap;

  color: var(--text-soft);

  font-size: 10px;
  font-weight: 700;
}

.history-meta {
  margin-top: 3px;

  color: var(--text-muted);

  font-size: 8px;
}

.history-actions {
  display: flex;

  gap: 5px;
}

.history-action {
  min-height: 28px;

  padding:
    0 8px;

  border-radius: 7px;

  background:
    rgba(255, 255, 255, 0.05);

  border:
    1px solid var(--border);

  color: var(--text-muted);

  font-size: 9px;
}

.history-action:hover {
  color: var(--text);

  background:
    rgba(255, 255, 255, 0.09);
}


/* =========================================================
   EMPTY STATE
   ========================================================= */

.empty-state {
  padding:
    18px 10px;

  text-align: center;

  color: var(--text-muted);

  font-size: 10px;

  border:
    1px dashed
    rgba(255, 255, 255, 0.08);

  border-radius: 9px;
}


/* =========================================================
   TOAST
   ========================================================= */

.toast-container {
  position: fixed;

  right: 18px;
  bottom: 18px;

  z-index: 9000;

  display: flex;

  flex-direction: column;

  align-items: flex-end;

  gap: 8px;

  pointer-events: none;
}

.toast {
  max-width:
    min(
      380px,
      calc(100vw - 36px)
    );

  padding:
    11px 13px;

  border-radius: 10px;

  background:
    rgba(12, 21, 36, 0.96);

  border:
    1px solid var(--border-strong);

  box-shadow:
    0 15px 40px
    rgba(0, 0, 0, 0.35);

  color: var(--text);

  font-size: 10px;

  animation:
    toastIn 180ms ease;
}

.toast.success {
  border-color:
    rgba(53, 211, 154, 0.28);
}

.toast.error {
  border-color:
    rgba(255, 92, 112, 0.28);
}

.toast.info {
  border-color:
    rgba(77, 163, 255, 0.28);
}


/* =========================================================
   FULLSCREEN
   ========================================================= */

.stage-shell:fullscreen {
  width: 100vw;
  height: 100vh;

  max-width: none;

  display: flex;

  align-items: center;
  justify-content: center;

  background:
    #000;

  border-radius: 0;
}

.stage-shell:fullscreen .stage {
  width:
    min(
      100vw,
      calc(100vh * 16 / 9)
    );

  height:
    min(
      100vh,
      calc(100vw * 9 / 16)
    );

  max-width: none;

  aspect-ratio:
    16 / 9;

  border-radius: 0;
}


/* =========================================================
   RESIZING
   ========================================================= */

body.is-resizing {
  cursor:
    nwse-resize;

  user-select: none;
}

body.is-resizing * {
  cursor:
    nwse-resize !important;
}


/* =========================================================
   RECORDING STATE
   ========================================================= */

body.is-recording .recording-status-bar {
  background:
    rgba(75, 7, 17, 0.95);

  border-bottom-color:
    rgba(255, 92, 112, 0.2);
}

body.is-recording .recording-status-dot {
  background:
    var(--red);

  box-shadow:
    0 0 12px
    rgba(255, 92, 112, 0.7);

  animation:
    recordingPulse 1s infinite;
}

body.is-recording .recording-overlay {
  display: flex;
}

body.is-recording .stage-badge {
  border-color:
    rgba(255, 92, 112, 0.2);
}

body.is-recording #stageSourceBadge {
  color:
    #ff8292;
}


/* =========================================================
   CAMERA ACTIVE
   ========================================================= */

body.camera-active #cameraIndicator {
  color:
    var(--green);

  border-color:
    rgba(53, 211, 154, 0.2);

  background:
    rgba(53, 211, 154, 0.07);
}


/* =========================================================
   MIC ACTIVE
   ========================================================= */

body.mic-active #micIndicator {
  color:
    var(--green);

  border-color:
    rgba(53, 211, 154, 0.2);

  background:
    rgba(53, 211, 154, 0.07);
}


/* =========================================================
   SCREEN ACTIVE
   ========================================================= */

body.screen-active #screenIndicator {
  color:
    var(--green);

  border-color:
    rgba(53, 211, 154, 0.2);

  background:
    rgba(53, 211, 154, 0.07);
}


/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes recordingPulse {

  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.45;
    transform: scale(0.82);
  }

}

@keyframes modalIn {

  from {
    opacity: 0;
    transform:
      translateY(12px)
      scale(0.985);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }

}

@keyframes toastIn {

  from {
    opacity: 0;
    transform:
      translateY(8px);
  }

  to {
    opacity: 1;
    transform:
      translateY(0);
  }

}


/* =========================================================
   RESPONSIVE — LARGE
   ========================================================= */

@media (max-width: 1500px) {

  :root {
    --sidebar-width: 320px;
  }

  .workspace {
    gap: 14px;
    padding: 14px;
  }

  .topbar {
    padding:
      10px 14px;
  }

  .recording-status-bar {
    padding:
      6px 14px;
  }

}


/* =========================================================
   RESPONSIVE — TABLET
   ========================================================= */

@media (max-width: 1180px) {

  :root {
    --sidebar-width: 300px;
  }

  .topbar {
    flex-wrap: wrap;
  }

  .topbar-actions {
    width: 100%;

    justify-content: flex-start;
  }

  .recording-status-bar {
    flex-wrap: wrap;
  }

  .recording-status-right {
    width: 100%;

    justify-content: flex-start;
  }

  .workspace {
    grid-template-columns:
      minmax(0, 1fr)
      300px;
  }

  .main-toolbar {
    flex-wrap: wrap;
  }

  .toolbar-right {
    margin-left: 0;
  }

}


/* =========================================================
   RESPONSIVE — TABLET / SMALL LAPTOP
   ========================================================= */

@media (max-width: 980px) {

  .workspace {
    grid-template-columns:
      1fr;
  }

  .sidebar {
    max-height: none;

    overflow: visible;

    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    align-items: start;
  }

  .recording-preview-layout {
    grid-template-columns:
      1fr;
  }

}


/* =========================================================
   RESPONSIVE — MOBILE
   ========================================================= */

@media (max-width: 700px) {

  :root {
    --topbar-height: auto;
  }

  body {
    font-size: 14px;
  }

  .topbar {
    position: relative;

    padding:
      10px;

    gap: 10px;
  }

  .brand-area {
    width: 100%;
  }

  .topbar-actions {
    width: 100%;

    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .topbar-btn,
  .record-main-btn {
    width: 100%;
  }

  .recording-status-bar {
    position: relative;

    top: auto;

    padding:
      8px 10px;

    gap: 8px;
  }

  .recording-status-left,
  .recording-status-center,
  .recording-status-right {
    width: 100%;

    flex-wrap: wrap;

    justify-content: flex-start;
  }

  .workspace {
    padding:
      10px;

    gap: 10px;
  }

  .stage-shell {
    border-radius: 11px;
  }

  .main-toolbar {
    padding:
      8px;

    gap: 7px;
  }

  .toolbar-group {
    width: 100%;
  }

  .toolbar-right {
    margin-left: 0;
  }

  .tool-btn {
    flex: 1;

    min-width: 0;
  }

  .sidebar {
    display: flex;

    flex-direction: column;

    gap: 9px;
  }

  .side-card {
    padding:
      12px;
  }

  .mentor-card {
    width: 30%;

    min-width: 100px;
  }

  .brand-badge {
    max-width: 45%;

    padding:
      6px 8px;

    font-size: 8px;
  }

  .stage-badges {
    gap: 3px;
  }

  .stage-badge {
    padding:
      0 5px;

    font-size: 7px;
  }

  .recording-overlay {
    padding:
      6px 8px;

    font-size: 8px;
  }

  .teleprompter-editor {
    grid-template-columns:
      1fr;

    padding:
      12px;
  }

  .teleprompter-editor textarea {
    min-height: 180px;
  }

  .teleprompter-preview {
    height: 260px;
  }

  .teleprompter-controls {
    grid-template-columns:
      1fr;

    padding:
      12px;
  }

  .modal {
    padding:
      8px;
  }

  .modal-panel {
    max-height:
      calc(100vh - 16px);

    border-radius:
      14px;
  }

  .modal-header {
    padding:
      14px;
  }

  .modal-body {
    padding:
      14px;
  }

  .modal-footer {
    padding:
      10px 14px;

    flex-wrap: wrap;
  }

  .recording-preview-layout {
    padding:
      12px;
  }

  .recording-history {
    margin:
      0 12px 14px;
  }

  .history-item {
    grid-template-columns:
      1fr;
  }

  .history-actions {
    width: 100%;
  }

  .history-action {
    flex: 1;
  }

}


/* =========================================================
   RESPONSIVE — SMALL PHONE
   ========================================================= */

@media (max-width: 450px) {

  .topbar-actions {
    grid-template-columns:
      1fr;
  }

  .recording-status-center {
    display: none;
  }

  .form-row {
    grid-template-columns:
      1fr;
  }

  .background-grid {
    grid-template-columns:
      1fr 1fr;
  }

  .file-buttons {
    grid-template-columns:
      1fr 1fr;
  }

  .recording-main-actions {
    grid-template-columns:
      1fr;
  }

  .trim-range {
    grid-template-columns:
      1fr;
  }

  .mentor-card {
    width: 34%;
  }

}


/* =========================================================
   TOUCH DEVICES
   ========================================================= */

@media (hover: none) {

  .topbar-btn:hover,
  .tool-btn:hover,
  .side-btn:hover,
  .file-btn:hover,
  .secondary-btn:hover {
    transform: none;
  }

  .mentor-resize {
    width: 30px;
    height: 30px;
  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }

}


/* =========================================================
   PRINT
   ========================================================= */

@media print {

  body {
    background: #fff;
    color: #000;
  }

  .topbar,
  .recording-status-bar,
  .sidebar,
  .main-toolbar,
  .modal,
  .toast-container {
    display: none !important;
  }

  .workspace {
    display: block;
    padding: 0;
  }

  .stage-shell {
    box-shadow: none;
  }

}


/* =========================================================
   END OF STYLE.CSS
   ========================================================= */
