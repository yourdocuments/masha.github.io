/* =========================================================
   BEFORE PAGE UNLOAD
   ========================================================= */

window.addEventListener(
  "beforeunload",
  () => {
    stopRecordingTimer();

    if (
      state.cameraStream
    ) {
      state.cameraStream
        .getTracks()
        .forEach(
          (track) =>
            track.stop()
        );
    }

    if (
      state.audio.micStream
    ) {
      state.audio.micStream
        .getTracks()
        .forEach(
          (track) =>
            track.stop()
        );
    }

    revokeUrl(
      state.mainObjectUrl
    );

    revokeUrl(
      state.mentorObjectUrl
    );

    revokeUrl(
      state.backgroundObjectUrl
    );
  }
);
