/* =========================================================
   SETTINGS
   ========================================================= */

function loadSettings() {
  try {
    const saved = localStorage.getItem(
      "personalCourseStudioSettings"
    );

    if (saved) {
      const parsed = JSON.parse(saved);

      if (parsed && typeof parsed === "object") {
        state.settings = {
          ...state.settings,
          ...parsed
        };
      }
    }
  } catch (error) {
    console.warn("Settings load failed:", error);
  }

  applyBrandName();
}


function applyBrandName() {
  const name =
    state.settings.brandName ||
    "Personal Course Studio";

  if (brandNameInput) {
    brandNameInput.value = name;
  }

  if (brandBadge) {
    const textElement =
      brandBadge.querySelector(
        "[data-brand-name]"
      );

    if (textElement) {
      textElement.textContent = name;
    } else {
      brandBadge.textContent = name;
    }
  }
}


function openSettings() {
  if (!settingsModal) return;

  settingsModal.classList.add("show");
  settingsModal.removeAttribute("hidden");

  if (brandNameInput) {
    brandNameInput.value =
      state.settings.brandName ||
      "Personal Course Studio";
  }
}


function closeSettings() {
  if (!settingsModal) return;

  settingsModal.classList.remove("show");
  settingsModal.setAttribute("hidden", "");
}


function saveSettings() {
  const name =
    brandNameInput?.value.trim() ||
    "Personal Course Studio";

  state.settings.brandName = name;

  try {
    localStorage.setItem(
      "personalCourseStudioSettings",
      JSON.stringify(state.settings)
    );
  } catch (error) {
    console.warn("Settings save failed:", error);
  }

  applyBrandName();
  closeSettings();
  showToast("Settings saved.");
}


