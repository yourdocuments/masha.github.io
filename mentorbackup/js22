/* =========================================================
   COMPOSITION RENDERING
   ========================================================= */

function requestRender() {
  if (
    !state.composition.canvas ||
    !state.composition.ctx
  ) {
    return;
  }

  renderCompositionFrame();
}


function renderCompositionFrame() {
  const canvas =
    state.composition.canvas;

  const ctx =
    state.composition.ctx;

  const width =
    state.composition.width;

  const height =
    state.composition.height;

  ctx.save();

  ctx.fillStyle =
    "#10141d";

  ctx.fillRect(
    0,
    0,
    width,
    height
  );

  drawMainStage(
    ctx,
    width,
    height
  );

  drawMentorOverlay(
    ctx,
    width,
    height
  );

  drawBrandBadge(
    ctx,
    width,
    height
  );

  ctx.restore();
}


/* =========================================================
   MAIN STAGE DRAW
   ========================================================= */

function drawMainStage(
  ctx,
  width,
  height
) {
  if (
    state.mainType === "image" &&
    mainImage?.complete &&
    mainImage.naturalWidth
  ) {
    drawMediaCover(
      ctx,
      mainImage,
      width,
      height
    );

    return;
  }

  if (
    state.mainType === "video" &&
    mainVideo?.readyState >=
      HTMLMediaElement.HAVE_CURRENT_DATA
  ) {
    drawMediaCover(
      ctx,
      mainVideo,
      width,
      height
    );

    return;
  }

  ctx.fillStyle =
    "#10141d";

  ctx.fillRect(
    0,
    0,
    width,
    height
  );

  ctx.fillStyle =
    "rgba(255,255,255,.55)";

  ctx.font =
    "600 32px system-ui";

  ctx.textAlign =
    "center";

  ctx.textBaseline =
    "middle";

  ctx.fillText(
    "Personal Course Studio",
    width / 2,
    height / 2
  );
}


/* =========================================================
   MEDIA COVER
   ========================================================= */

function drawMediaCover(
  ctx,
  media,
  width,
  height
) {
  const sourceWidth =
    media.videoWidth ||
    media.naturalWidth ||
    media.width;

  const sourceHeight =
    media.videoHeight ||
    media.naturalHeight ||
    media.height;

  if (
    !sourceWidth ||
    !sourceHeight
  ) {
    return;
  }

  const sourceRatio =
    sourceWidth /
    sourceHeight;

  const targetRatio =
    width / height;

  let drawWidth =
    width;

  let drawHeight =
    height;

  let x = 0;
  let y = 0;

  if (
    sourceRatio > targetRatio
  ) {
    drawHeight =
      height;

    drawWidth =
      height *
      sourceRatio;

    x =
      (width -
        drawWidth) /
      2;
  } else {
    drawWidth =
      width;

    drawHeight =
      width /
      sourceRatio;

    y =
      (height -
        drawHeight) /
      2;
  }

  ctx.drawImage(
    media,
    x,
    y,
    drawWidth,
    drawHeight
  );
}


/* =========================================================
   MENTOR OVERLAY
   ========================================================= */

function drawMentorOverlay(
  ctx,
  width,
  height
) {
  if (
    !mentorCard ||
    mentorCard.style.display ===
      "none"
  ) {
    return;
  }

  let source = null;

  if (
    state.mentorType === "camera"
  ) {
    if (
      state.backgroundMode ===
        "original" &&
      mentorCameraVideo.readyState >=
        HTMLMediaElement.HAVE_CURRENT_DATA
    ) {
      source =
        mentorCameraVideo;
    } else if (
      mentorAICanvas.style.display !==
        "none" &&
      mentorAICanvas.width &&
      mentorAICanvas.height
    ) {
      source =
        mentorAICanvas;
    }
  }

  if (
    state.mentorType === "video"
  ) {
    source = mentorVideo;
  }

  if (!source) {
    return;
  }

  const stageRect =
    stage.getBoundingClientRect();

  const cardRect =
    mentorCard.getBoundingClientRect();

  if (
    !stageRect.width ||
    !stageRect.height ||
    !cardRect.width ||
    !cardRect.height
  ) {
    return;
  }

  const x =
    ((cardRect.left -
      stageRect.left) /
      stageRect.width) *
    width;

  const y =
    ((cardRect.top -
      stageRect.top) /
      stageRect.height) *
    height;

  const drawWidth =
    (cardRect.width /
      stageRect.width) *
    width;

  const drawHeight =
    (cardRect.height /
      stageRect.height) *
    height;

  ctx.save();

  /* Soft shadow */
  ctx.shadowColor =
    "rgba(0,0,0,.45)";

  ctx.shadowBlur = 35;
  ctx.shadowOffsetY = 12;

  roundRect(
    ctx,
    x,
    y,
    drawWidth,
    drawHeight,
    28
  );

  ctx.clip();

  ctx.shadowColor =
    "transparent";

  drawMediaCover(
    ctx,
    source,
    drawWidth,
    drawHeight
  );

  ctx.restore();

  /* Border */
  ctx.save();

  ctx.strokeStyle =
    "rgba(255,255,255,.16)";

  ctx.lineWidth = 3;

  roundRect(
    ctx,
    x,
    y,
    drawWidth,
    drawHeight,
    28
  );

  ctx.stroke();

  ctx.restore();
}


/* =========================================================
   BRAND BADGE
   ========================================================= */

function drawBrandBadge(
  ctx,
  width,
  height
) {
  const name =
    state.settings.brandName ||
    "Personal Course Studio";

  const paddingX = 22;
  const paddingY = 12;

  ctx.save();

  ctx.font =
    "600 24px system-ui";

  const textWidth =
    ctx.measureText(name)
      .width;

  const badgeWidth =
    textWidth +
    paddingX * 2;

  const badgeHeight =
    52;

  const x = 28;
  const y =
    height -
    badgeHeight -
    28;

  ctx.fillStyle =
    "rgba(5,8,14,.72)";

  roundRect(
    ctx,
    x,
    y,
    badgeWidth,
    badgeHeight,
    16
  );

  ctx.fill();

  ctx.fillStyle =
    "#ffffff";

  ctx.textAlign =
    "left";

  ctx.textBaseline =
    "middle";

  ctx.fillText(
    name,
    x + paddingX,
    y +
      badgeHeight / 2
  );

  ctx.restore();
}


/* =========================================================
   ROUND RECT
   ========================================================= */

function roundRect(
  ctx,
  x,
  y,
  width,
  height,
  radius
) {
  const r =
    Math.min(
      radius,
      width / 2,
      height / 2
    );

  ctx.beginPath();

  ctx.moveTo(
    x + r,
    y
  );

  ctx.arcTo(
    x + width,
    y,
    x + width,
    y + height,
    r
  );

  ctx.arcTo(
    x + width,
    y + height,
    x,
    y + height,
    r
  );

  ctx.arcTo(
    x,
    y + height,
    x,
    y,
    r
  );

  ctx.arcTo(
    x,
    y,
    x + width,
    y,
    r
  );

  ctx.closePath();
}


/* =========================================================
   RECORD BUTTON
   ========================================================= */

async function handleRecordButton() {
  if (!state.recording.active) {
    await startRecording();
    return;
  }

  if (state.recording.paused) {
    resumeRecording();
    return;
  }

  pauseRecording();
}


/* =========================================================
   START RECORDING
   ========================================================= */

async function startRecording() {
  if (
    state.recording.active
  ) {
    return;
  }

  if (
    !state.composition.canvas
  ) {
    initializeComposition();
  }

  await resumeAudioContext();

  /*
   * Prepare microphone before MediaRecorder.
   */
  await prepareMicrophone();

  updateMainAudioGain();
  updateMentorAudioGain();

  renderCompositionFrame();

  const videoStream =
    state.composition.canvas.captureStream(
      30
    );

  state.recording.videoStream =
    videoStream;

  const finalStream =
    new MediaStream();

  videoStream
    .getVideoTracks()
    .forEach((track) => {
      finalStream.addTrack(track);
    });

  if (
    state.audio.destination
  ) {
    const audioTracks =
      state.audio.destination.stream
        .getAudioTracks();

    audioTracks.forEach(
      (track) => {
        finalStream.addTrack(track);
      }
    );
  }

  state.recording.stream =
    finalStream;

  const mimeType =
    getSupportedMimeType();

  let recorder;

  try {
    recorder =
      new MediaRecorder(
        finalStream,
        {
          mimeType
        }
      );
  } catch (error) {
    console.warn(
      "Preferred recorder failed:",
      error
    );

    recorder =
      new MediaRecorder(
        finalStream
      );
  }

  state.recording.mediaRecorder =
    recorder;

  state.recording.chunks = [];

  recorder.ondataavailable =
    (event) => {
      if (
        event.data &&
        event.data.size > 0
      ) {
        state.recording.chunks.push(
          event.data
        );
      }
    };

  recorder.onstop =
    handleRecordingStopped;

  recorder.onerror =
    (event) => {
      console.error(
        "MediaRecorder error:",
        event.error
      );

      showToast(
        "Recording error occurred."
      );
    };

  try {
    recorder.start(1000);
  } catch (error) {
    console.error(
      "Recorder start failed:",
      error
    );

    cleanupRecordingResources();

    showToast(
      "Recording could not start."
    );

    return;
  }

  state.recording.active =
    true;

  state.recording.paused =
    false;

  state.recording.startTime =
    performance.now();

  state.recording.pausedAt = 0;
  state.recording.totalPaused = 0;

  startRecordingTimer();
  updateRecordUI();

  if (
    state.teleprompter.startWithRecording
  ) {
    openTeleprompter();

    if (
      state.teleprompter.showWhileRecording
    ) {
      startTeleprompter();
    }
  }

  showToast(
    "Recording started."
  );
}


/* =========================================================
   STOP RECORDING
   ========================================================= */

function stopRecording() {
  if (
    !state.recording.active
  ) {
    return;
  }

  const recorder =
    state.recording.mediaRecorder;

  if (
    recorder &&
    recorder.state !== "inactive"
  ) {
    recorder.stop();
  }
}


/* =========================================================
   PAUSE RECORDING
   ========================================================= */

function pauseRecording() {
  const recorder =
    state.recording.mediaRecorder;

  if (
    !state.recording.active ||
    !recorder ||
    recorder.state !== "recording"
  ) {
    return;
  }

  try {
    recorder.pause();

    state.recording.paused =
      true;

    state.recording.pausedAt =
      performance.now();

    updateRecordUI();

    showToast(
      "Recording paused."
    );
  } catch (error) {
    console.warn(
      "Pause failed:",
      error
    );
  }
}


/* =========================================================
   RESUME RECORDING
   ========================================================= */

function resumeRecording() {
  const recorder =
    state.recording.mediaRecorder;

  if (
    !state.recording.active ||
    !recorder ||
    recorder.state !== "paused"
  ) {
    return;
  }

  try {
    const now =
      performance.now();

    if (
      state.recording.pausedAt
    ) {
      state.recording.totalPaused +=
        now -
        state.recording.pausedAt;
    }

    recorder.resume();

    state.recording.paused =
      false;

    state.recording.pausedAt = 0;

    updateRecordUI();

    showToast(
      "Recording resumed."
    );
  } catch (error) {
    console.warn(
      "Resume failed:",
      error
    );
  }
}


/* =========================================================
   RECORDING TIMER
   ========================================================= */

function startRecordingTimer() {
  stopRecordingTimer();

  state.recording.timer =
    setInterval(
      updateRecordingTimer,
      250
    );
}


function stopRecordingTimer() {
  if (
    state.recording.timer
  ) {
    clearInterval(
      state.recording.timer
    );

    state.recording.timer =
      null;
  }
}


function updateRecordingTimer() {
  if (
    !state.recording.active
  ) {
    return;
  }

  const now =
    performance.now();

  let elapsed =
    now -
    state.recording.startTime;

  elapsed -=
    state.recording.totalPaused;

  if (
    state.recording.paused &&
    state.recording.pausedAt
  ) {
    elapsed -=
      now -
      state.recording.pausedAt;
  }

  updateRecordingTimerUI(
    elapsed
  );
}


function updateRecordingTimerUI(
  milliseconds
) {
  const totalSeconds =
    Math.max(
      0,
      Math.floor(
        milliseconds / 1000
      )
    );

  const hours =
    Math.floor(
      totalSeconds / 3600
    );

  const minutes =
    Math.floor(
      (totalSeconds % 3600) /
        60
    );

  const seconds =
    totalSeconds % 60;

  const text =
    [
      hours,
      minutes,
      seconds
    ]
      .map(
        (value) =>
          String(value).padStart(
            2,
            "0"
          )
      )
      .join(":");

  const selectors = [
    "[data-recording-time]",
    "#recordingTime"
  ];

  selectors.forEach(
    (selector) => {
      document
        .querySelectorAll(selector)
        .forEach(
          (element) => {
            element.textContent =
              text;
          }
        );
    }
  );
}


/* =========================================================
   RECORD UI
   ========================================================= */

function updateRecordUI() {
  if (!recordBtn) return;

  if (
    !state.recording.active
  ) {
    recordBtn.classList.remove(
      "recording",
      "paused"
    );

    const icon =
      recordBtn.querySelector(
        "[data-record-icon]"
      );

    const text =
      recordBtn.querySelector(
        "[data-record-text]"
      );

    if (icon) {
      icon.textContent = "●";
    }

    if (text) {
      text.textContent =
        "Record";
    } else {
      recordBtn.textContent =
        "● Record";
    }

    return;
  }

  if (
    state.recording.paused
  ) {
    recordBtn.classList.add(
      "paused"
    );

    recordBtn.classList.remove(
      "recording"
    );

    const icon =
      recordBtn.querySelector(
        "[data-record-icon]"
      );

    const text =
      recordBtn.querySelector(
        "[data-record-text]"
      );

    if (icon) {
      icon.textContent = "▶";
    }

    if (text) {
      text.textContent =
        "Resume";
    } else {
      recordBtn.textContent =
        "▶ Resume";
    }

    return;
  }

  recordBtn.classList.add(
    "recording"
  );

  recordBtn.classList.remove(
    "paused"
  );

  const icon =
    recordBtn.querySelector(
      "[data-record-icon]"
    );

  const text =
    recordBtn.querySelector(
      "[data-record-text]"
    );

  if (icon) {
    icon.textContent = "■";
  }

  if (text) {
    text.textContent =
      "Pause";
  } else {
    recordBtn.textContent =
      "■ Pause";
  }
}


/* =========================================================
   RECORDING STOPPED
   ========================================================= */

function handleRecordingStopped() {
  stopRecordingTimer();

  state.recording.active =
    false;

  state.recording.paused =
    false;

  updateRecordUI();

  const blob =
    new Blob(
      state.recording.chunks,
      {
        type:
          getSupportedMimeType()
      }
    );

  cleanupRecordingResources(
    false
  );

  if (!blob.size) {
    showToast(
      "No recording data was created."
    );

    return;
  }

  showRecordingPreview(
    blob
  );
}


/* =========================================================
   PREVIEW MODAL
   ========================================================= */

function showRecordingPreview(
  blob
) {
  const url =
    URL.createObjectURL(blob);

  let modal =
    document.getElementById(
      "courseStudioRecordingPreview"
    );

  if (!modal) {
    modal =
      document.createElement(
        "div"
      );

    modal.id =
      "courseStudioRecordingPreview";

    modal.innerHTML = `
      <div class="record-preview-card">

        <div class="record-preview-header">
          <div>
            <strong>Recording Preview</strong>
            <small>Review your final course recording</small>
          </div>

          <button
            type="button"
            data-preview-close
          >
            ×
          </button>
        </div>

        <video
          data-preview-video
          controls
          playsinline
        ></video>

        <div class="record-preview-actions">

          <button
            type="button"
            data-preview-download
          >
            Download
          </button>

          <button
            type="button"
            data-preview-again
          >
            Record Again
          </button>

          <button
            type="button"
            data-preview-delete
          >
            Delete
          </button>

        </div>

      </div>
    `;

    document.body.appendChild(
      modal
    );

    injectPreviewStyles();

    on(
      modal.querySelector(
        "[data-preview-close]"
      ),
      "click",
      () => {
        closeRecordingPreview();
      }
    );

    on(
      modal.querySelector(
        "[data-preview-download]"
      ),
      "click",
      () => {
        downloadRecording(blob);
      }
    );

    on(
      modal.querySelector(
        "[data-preview-again]"
      ),
      "click",
      () => {
        closeRecordingPreview();

        startRecording();
      }
    );

    on(
      modal.querySelector(
        "[data-preview-delete]"
      ),
      "click",
      () => {
        closeRecordingPreview();

        showToast(
          "Recording deleted."
        );
      }
    );
  }

  const video =
    modal.querySelector(
      "[data-preview-video]"
    );

  if (video.dataset.objectUrl) {
    revokeUrl(
      video.dataset.objectUrl
    );
  }

  video.dataset.objectUrl =
    url;

  video.src = url;

  modal.classList.add("show");

  state.recording.previewBlob =
    blob;

  state.recording.previewUrl =
    url;
}


function closeRecordingPreview() {
  const modal =
    document.getElementById(
      "courseStudioRecordingPreview"
    );

  if (!modal) return;

  const video =
    modal.querySelector(
      "[data-preview-video]"
    );

  if (video?.dataset.objectUrl) {
    revokeUrl(
      video.dataset.objectUrl
    );

    delete video.dataset.objectUrl;
  }

  modal.classList.remove(
    "show"
  );
}


