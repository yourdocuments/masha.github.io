function updateVolumeLabels() {
  if (mainVolumeValue) {
    const value =
      Number(
        mainVideoVolume?.value || 100
      );

    mainVolumeValue.textContent =
      `${Math.round(value)}%`;
  }

  if (micVolumeValue) {
    const value =
      Number(
        micVolume?.value || 100
      );

    micVolumeValue.textContent =
      `${Math.round(value)}%`;
  }
}


function ensureAudioContext() {
  if (
    state.audio.context &&
    state.audio.destination
  ) {
    return state.audio.context;
  }

  const AudioContextClass =
    window.AudioContext ||
    window.webkitAudioContext;

  if (!AudioContextClass) {
    showToast(
      "Web Audio is not supported."
    );

    return null;
  }

  const context =
    new AudioContextClass();

  state.audio.context = context;

  state.audio.destination =
    context.createMediaStreamDestination();

  state.audio.initialized = true;

  return context;
}


async function resumeAudioContext() {
  const context =
    ensureAudioContext();

  if (!context) return null;

  if (context.state === "suspended") {
    try {
      await context.resume();
    } catch (error) {
      console.warn(
        "Audio resume failed:",
        error
      );
    }
  }

  return context;
}


/* =========================================================
   MAIN AUDIO GRAPH
   ========================================================= */

function ensureMainAudioGraph() {
  const context =
    ensureAudioContext();

  if (!context || !mainVideo) {
    return;
  }

  if (!state.audio.mainSource) {
    try {
      state.audio.mainSource =
        context.createMediaElementSource(
          mainVideo
        );

      state.audio.mainGain =
        context.createGain();

      state.audio.mainSource.connect(
        state.audio.mainGain
      );

      state.audio.mainGain.connect(
        state.audio.destination
      );

      state.audio.mainGain.connect(
        context.destination
      );
    } catch (error) {
      console.warn(
        "Main audio graph error:",
        error
      );
    }
  }
}


function updateMainAudioGain() {
  if (!mainVideo) return;

  const context =
    ensureAudioContext();

  if (!context) return;

  ensureMainAudioGraph();

  if (!state.audio.mainGain) {
    return;
  }

  const enabled =
    mainVideoAudioCheckbox
      ? mainVideoAudioCheckbox.checked
      : true;

  const volume =
    Number(
      mainVideoVolume?.value || 100
    ) / 100;

  state.audio.mainGain.gain.value =
    enabled ? volume : 0;
}


/* =========================================================
   MENTOR AUDIO GRAPH
   ========================================================= */

function ensureMentorAudioGraph() {
  const context =
    ensureAudioContext();

  if (!context || !mentorVideo) {
    return;
  }

  if (!state.audio.mentorSource) {
    try {
      state.audio.mentorSource =
        context.createMediaElementSource(
          mentorVideo
        );

      state.audio.mentorGain =
        context.createGain();

      state.audio.mentorSource.connect(
        state.audio.mentorGain
      );

      /*
       * Mentor video audio is kept at 0 by
       * default to prevent unwanted duplicate
       * audio. It can be enabled later.
       */
      state.audio.mentorGain.gain.value =
        0;

      state.audio.mentorGain.connect(
        state.audio.destination
      );

      state.audio.mentorGain.connect(
        context.destination
      );
    } catch (error) {
      console.warn(
        "Mentor audio graph error:",
        error
      );
    }
  }
}


function updateMentorAudioGain() {
  ensureMentorAudioGraph();

  if (!state.audio.mentorGain) {
    return;
  }

  state.audio.mentorGain.gain.value =
    0;
}


/* =========================================================
   MICROPHONE
   ========================================================= */

async function prepareMicrophone() {
  const enabled =
    micEnabled
      ? micEnabled.checked
      : true;

  if (!enabled) {
    updateMicStatus(
      "Microphone disabled"
    );

    return false;
  }

  if (
    !navigator.mediaDevices ||
    !navigator.mediaDevices.getUserMedia
  ) {
    updateMicStatus(
      "Microphone unsupported"
    );

    return false;
  }

  const context =
    await resumeAudioContext();

  if (!context) {
    return false;
  }

  try {
    if (state.audio.micStream) {
      state.audio.micStream
        .getTracks()
        .forEach((track) =>
          track.stop()
        );

      state.audio.micStream = null;
    }

    const stream =
      await navigator.mediaDevices.getUserMedia(
        {
          audio: {
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: true
          },
          video: false
        }
      );

    state.audio.micStream =
      stream;

    state.recording.audioStream =
      stream;

    if (state.audio.micSource) {
      try {
        state.audio.micSource.disconnect();
      } catch {}
    }

    state.audio.micSource =
      context.createMediaStreamSource(
        stream
      );

    state.audio.micGain =
      context.createGain();

    state.audio.micSource.connect(
      state.audio.micGain
    );

    state.audio.micGain.connect(
      state.audio.destination
    );

    state.audio.micMonitorGain =
      context.createGain();

    state.audio.micGain.connect(
      state.audio.micMonitorGain
    );

    state.audio.micMonitorGain.connect(
      context.destination
    );

    updateMicGain();
    updateMicMonitor();

    updateMicStatus(
      "Microphone ready"
    );

    return true;
  } catch (error) {
    console.error(
      "Microphone error:",
      error
    );

    updateMicStatus(
      "Microphone permission denied"
    );

    showToast(
      "Microphone permission was not granted."
    );

    return false;
  }
}


function updateMicGain() {
  if (!state.audio.micGain) {
    return;
  }

  const enabled =
    micEnabled
      ? micEnabled.checked
      : true;

  const volume =
    Number(
      micVolume?.value || 100
    ) / 100;

  state.audio.micGain.gain.value =
    enabled ? volume : 0;

  updateMicMonitor();
}


function updateMicMonitor() {
  if (!state.audio.micMonitorGain) {
    return;
  }

  const enabled =
    micEnabled
      ? micEnabled.checked
      : true;

  const monitor =
    micMonitor
      ? micMonitor.checked
      : false;

  state.audio.micMonitorGain.gain.value =
    enabled && monitor ? 1 : 0;
}


function updateMicStatus(
  customMessage = null
) {
  let message =
    customMessage;

  if (!message) {
    if (
      micEnabled &&
      !micEnabled.checked
    ) {
      message =
        "Microphone disabled";
    } else if (
      state.audio.micStream
    ) {
      message =
        "Microphone ready";
    } else {
      message =
        "Microphone not connected";
    }
  }

  micStatusElements.forEach(
    (element) => {
      element.textContent =
        message;
    }
  );
}


