function bindTeleprompterEvents() {
  const panel =
    state.teleprompter.panel;

  if (!panel) return;

  const textarea =
    state.teleprompter.textarea;

  const preview =
    panel.querySelector(
      "[data-tp-preview]"
    );

  const play =
    panel.querySelector(
      "[data-tp-play]"
    );

  const reset =
    panel.querySelector(
      "[data-tp-reset]"
    );

  const speed =
    panel.querySelector(
      "[data-tp-speed]"
    );

  const font =
    panel.querySelector(
      "[data-tp-font]"
    );

  const opacity =
    panel.querySelector(
      "[data-tp-opacity]"
    );

  const file =
    panel.querySelector(
      "[data-tp-file]"
    );

  const save =
    panel.querySelector(
      "[data-tp-save]"
    );

  const clear =
    panel.querySelector(
      "[data-tp-clear]"
    );

  const minimize =
    panel.querySelector(
      "[data-tp-minimize]"
    );

  const close =
    panel.querySelector(
      "[data-tp-close]"
    );

  const startRecord =
    panel.querySelector(
      "[data-tp-start-record]"
    );

  const showRecording =
    panel.querySelector(
      "[data-tp-show-recording]"
    );

  on(textarea, "input", () => {
    updateTeleprompterText();
  });

  on(play, "click", () => {
    toggleTeleprompter();
  });

  on(reset, "click", () => {
    resetTeleprompter();
  });

  on(speed, "input", () => {
    state.teleprompter.speed =
      Number(speed.value);

    panel.querySelector(
      "[data-tp-speed-value]"
    ).textContent =
      `${Number(speed.value).toFixed(1)}x`;
  });

  on(font, "input", () => {
    state.teleprompter.fontSize =
      Number(font.value);

    panel.querySelector(
      "[data-tp-font-value]"
    ).textContent =
      `${font.value}px`;

    applyTeleprompterStyles();
  });

  on(opacity, "input", () => {
    state.teleprompter.opacity =
      Number(opacity.value) / 100;

    panel.querySelector(
      "[data-tp-opacity-value]"
    ).textContent =
      `${opacity.value}%`;

    applyTeleprompterStyles();
  });

  on(file, "change", handleTeleprompterFile);

  on(save, "click", saveTeleprompterText);

  on(clear, "click", () => {
    textarea.value = "";
    updateTeleprompterText();
    resetTeleprompter();
  });

  on(minimize, "click", () => {
    panel.classList.toggle(
      "minimized"
    );
  });

  on(close, "click", closeTeleprompter);

  on(
    startRecord,
    "change",
    () => {
      state.teleprompter.startWithRecording =
        startRecord.checked;
    }
  );

  on(
    showRecording,
    "change",
    () => {
      state.teleprompter.showWhileRecording =
        showRecording.checked;
    }
  );

  on(preview, "scroll", updateTeleprompterProgress);

  applyTeleprompterStyles();
}


function openTeleprompter() {
  if (
    !state.teleprompter.initialized
  ) {
    createTeleprompter();
  }

  state.teleprompter.panel?.classList.add(
    "show"
  );
}


function closeTeleprompter() {
  stopTeleprompter();

  state.teleprompter.panel?.classList.remove(
    "show"
  );
}


function updateTeleprompterText() {
  const textarea =
    state.teleprompter.textarea;

  const content =
    state.teleprompter.content;

  if (!textarea || !content) {
    return;
  }

  const text =
    textarea.value ||
    "Paste your class script here...";

  content.textContent = text;

  saveTeleprompterDraft();
  updateTeleprompterProgress();
}


function toggleTeleprompter() {
  if (state.teleprompter.running) {
    stopTeleprompter();
  } else {
    startTeleprompter();
  }
}


function startTeleprompter() {
  const panel =
    state.teleprompter.panel;

  if (!panel) return;

  const preview =
    panel.querySelector(
      "[data-tp-preview]"
    );

  const play =
    panel.querySelector(
      "[data-tp-play]"
    );

  state.teleprompter.running =
    true;

  if (play) {
    play.textContent =
      "❚❚ Pause";
  }

  let lastTime = performance.now();

  const loop = (time) => {
    if (
      !state.teleprompter.running
    ) {
      return;
    }

    const delta =
      time - lastTime;

    lastTime = time;

    const movement =
      (delta / 16.67) *
      state.teleprompter.speed;

    preview.scrollTop +=
      movement;

    updateTeleprompterProgress();

    state.teleprompter.animationFrame =
      requestAnimationFrame(loop);
  };

  state.teleprompter.animationFrame =
    requestAnimationFrame(loop);
}


function stopTeleprompter() {
  state.teleprompter.running =
    false;

  if (
    state.teleprompter.animationFrame
  ) {
    cancelAnimationFrame(
      state.teleprompter.animationFrame
    );

    state.teleprompter.animationFrame =
      null;
  }

  const play =
    state.teleprompter.panel?.querySelector(
      "[data-tp-play]"
    );

  if (play) {
    play.textContent =
      "▶ Start";
  }
}


function resetTeleprompter() {
  stopTeleprompter();

  const preview =
    state.teleprompter.panel?.querySelector(
      "[data-tp-preview]"
    );

  if (preview) {
    preview.scrollTop = 0;
  }

  updateTeleprompterProgress();
}


function updateTeleprompterProgress() {
  const panel =
    state.teleprompter.panel;

  if (!panel) return;

  const preview =
    panel.querySelector(
      "[data-tp-preview]"
    );

  const progress =
    panel.querySelector(
      "[data-tp-progress]"
    );

  if (!preview || !progress) {
    return;
  }

  const maxScroll =
    preview.scrollHeight -
    preview.clientHeight;

  if (maxScroll <= 0) {
    progress.style.width =
      "0%";
    return;
  }

  const percent =
    (preview.scrollTop /
      maxScroll) *
    100;

  progress.style.width =
    `${Math.max(
      0,
      Math.min(100, percent)
    )}%`;
}


function applyTeleprompterStyles() {
  const panel =
    state.teleprompter.panel;

  if (!panel) return;

  const preview =
    panel.querySelector(
      "[data-tp-preview]"
    );

  if (!preview) return;

  preview.style.fontSize =
    `${state.teleprompter.fontSize}px`;

  preview.style.opacity =
    String(state.teleprompter.opacity);
}


