/* =========================================================
   CAMERA
   ========================================================= */

async function startCamera() {
  try {
    if (
      !navigator.mediaDevices ||
      !navigator.mediaDevices.getUserMedia
    ) {
      showToast(
        "Camera access is not supported by this browser."
      );
      return;
    }

    stopCamera();

    updateCameraStatus("Starting camera...");

    const stream =
      await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: state.cameraFacingMode,
          width: {
            ideal: 1280
          },
          height: {
            ideal: 720
          }
        },
        audio: false
      });

    state.cameraStream = stream;

    mentorCameraVideo.srcObject = stream;

    mentorCameraVideo.style.display = "block";
    mentorVideo.style.display = "none";
    mentorPlaceholder.style.display = "none";

    state.mentorType = "camera";

    if (mentorSourceLabel) {
      mentorSourceLabel.textContent =
        state.cameraFacingMode === "user"
          ? "Camera"
          : "Rear Camera";
    }

    mentorCameraVideo.muted = true;
    mentorCameraVideo.playsInline = true;

    await mentorCameraVideo.play();

    updateCameraStatus("Camera live");

    await initializeSegmentation();

    if (
      state.backgroundMode === "original"
    ) {
      mentorAICanvas.style.display = "none";
    } else {
      mentorAICanvas.style.display = "block";
      startSegmentationLoop();
    }

    requestRender();

    showToast("Camera started.");
  } catch (error) {
    console.error("Camera error:", error);

    state.cameraStream = null;

    updateCameraStatus(
      "Camera permission denied"
    );

    showToast(
      "Camera could not be started. Please allow camera permission."
    );
  }
}


function stopCamera() {
  if (state.cameraStream) {
    state.cameraStream
      .getTracks()
      .forEach((track) => track.stop());

    state.cameraStream = null;
  }

  if (mentorCameraVideo) {
    mentorCameraVideo.pause();
    mentorCameraVideo.srcObject = null;
    mentorCameraVideo.style.display = "none";
  }

  if (
    state.mentorType === "camera"
  ) {
    state.mentorType = null;

    if (mentorPlaceholder) {
      mentorPlaceholder.style.display = "flex";
    }

    if (mentorSourceLabel) {
      mentorSourceLabel.textContent =
        "Mentor";
    }
  }

  updateCameraStatus("Camera stopped");

  requestRender();
}


async function switchCamera() {
  if (!state.cameraStream) {
    state.cameraFacingMode =
      state.cameraFacingMode === "user"
        ? "environment"
        : "user";

    showToast(
      state.cameraFacingMode === "user"
        ? "Front camera selected."
        : "Rear camera selected."
    );

    return;
  }

  state.cameraFacingMode =
    state.cameraFacingMode === "user"
      ? "environment"
      : "user";

  await startCamera();
}


function updateCameraStatus(message) {
  if (!cameraStatus) return;

  cameraStatus.textContent = message;
}


/* =========================================================
   AI SEGMENTATION
   ========================================================= */

function initializeAI() {
  if (!aiCanvas || !aiSourceCanvas || !aiMaskCanvas) {
    return;
  }

  aiCanvas.width = 1280;
  aiCanvas.height = 720;

  aiSourceCanvas.width = 1280;
  aiSourceCanvas.height = 720;

  aiMaskCanvas.width = 1280;
  aiMaskCanvas.height = 720;
}


async function initializeSegmentation() {
  if (state.segmentationReady) {
    return true;
  }

  if (
    typeof SelfieSegmentation ===
    "undefined"
  ) {
    console.warn(
      "MediaPipe Selfie Segmentation not loaded."
    );

    showToast(
      "AI background module is not available."
    );

    return false;
  }

  try {
    state.segmentation =
      new SelfieSegmentation({
        locateFile: (file) => {
          return (
            "https://cdn.jsdelivr.net/npm/@mediapipe/selfie_segmentation/" +
            file
          );
        }
      });

    state.segmentation.setOptions({
      modelSelection: 1
    });

    state.segmentation.onResults(
      handleSegmentationResults
    );

    state.segmentationReady = true;

    return true;
  } catch (error) {
    console.error(
      "Segmentation initialization failed:",
      error
    );

    return false;
  }
}


function startSegmentationLoop() {
  if (state.segmentationRunning) {
    return;
  }

  if (!state.cameraStream) {
    return;
  }

  if (!state.segmentationReady) {
    return;
  }

  state.segmentationRunning = true;

  runSegmentationFrame();
}


async function runSegmentationFrame() {
  if (!state.segmentationRunning) {
    return;
  }

  if (
    !state.cameraStream ||
    !mentorCameraVideo ||
    mentorCameraVideo.readyState <
      HTMLMediaElement.HAVE_CURRENT_DATA
  ) {
    requestAnimationFrame(
      runSegmentationFrame
    );

    return;
  }

  try {
    await state.segmentation.send({
      image: mentorCameraVideo
    });
  } catch (error) {
    console.warn(
      "Segmentation frame failed:",
      error
    );
  }

  requestAnimationFrame(
    runSegmentationFrame
  );
}


/* =========================================================
   SEGMENTATION RESULT
   ========================================================= */

let personCanvas = null;
let personCtx = null;

function ensurePersonCanvas(width, height) {
  if (
    !personCanvas ||
    personCanvas.width !== width ||
    personCanvas.height !== height
  ) {
    personCanvas =
      document.createElement("canvas");

    personCanvas.width = width;
    personCanvas.height = height;

    personCtx =
      personCanvas.getContext("2d", {
        willReadFrequently: true
      });
  }
}


function handleSegmentationResults(results) {
  if (!results?.image || !results?.segmentationMask) {
    return;
  }

  const image = results.image;
  const mask = results.segmentationMask;

  const width = image.videoWidth || image.width;
  const height = image.videoHeight || image.height;

  if (!width || !height) return;

  if (
    aiSourceCanvas.width !== width ||
    aiSourceCanvas.height !== height
  ) {
    aiSourceCanvas.width = width;
    aiSourceCanvas.height = height;

    aiMaskCanvas.width = width;
    aiMaskCanvas.height = height;

    aiCanvas.width = width;
    aiCanvas.height = height;
  }

  const sourceCtx =
    aiSourceCanvas.getContext("2d", {
      willReadFrequently: true
    });

  const maskCtx =
    aiMaskCanvas.getContext("2d", {
      willReadFrequently: true
    });

  const outputCtx =
    aiCanvas.getContext("2d");

  sourceCtx.clearRect(
    0,
    0,
    width,
    height
  );

  sourceCtx.drawImage(
    image,
    0,
    0,
    width,
    height
  );

  maskCtx.clearRect(
    0,
    0,
    width,
    height
  );

  maskCtx.drawImage(
    mask,
    0,
    0,
    width,
    height
  );

  if (
    state.backgroundMode ===
    "original"
  ) {
    outputCtx.clearRect(
      0,
      0,
      width,
      height
    );

    outputCtx.drawImage(
      image,
      0,
      0,
      width,
      height
    );

    requestRender();
    return;
  }

  const sourceData =
    sourceCtx.getImageData(
      0,
      0,
      width,
      height
    );

  const maskData =
    maskCtx.getImageData(
      0,
      0,
      width,
      height
    );

  ensurePersonCanvas(
    width,
    height
  );

  const personImageData =
    personCtx.createImageData(
      width,
      height
    );

  const src = sourceData.data;
  const msk = maskData.data;
  const out = personImageData.data;

  for (
    let i = 0;
    i < src.length;
    i += 4
  ) {
    const confidence =
      msk[i] / 255;

    const alpha = Math.max(
      0,
      Math.min(
        255,
        ((confidence - 0.15) / 0.65) *
          255
      )
    );

    out[i] = src[i];
    out[i + 1] = src[i + 1];
    out[i + 2] = src[i + 2];
    out[i + 3] = alpha;
  }

  personCtx.putImageData(
    personImageData,
    0,
    0
  );

  outputCtx.clearRect(
    0,
    0,
    width,
    height
  );

  if (
    state.backgroundMode ===
    "blur"
  ) {
    outputCtx.save();

    outputCtx.filter =
      "blur(18px)";

    outputCtx.drawImage(
      image,
      -20,
      -20,
      width + 40,
      height + 40
    );

    outputCtx.restore();
  }

  if (
    state.backgroundMode ===
    "image" &&
    state.backgroundImage
  ) {
    drawCoverImage(
      outputCtx,
      state.backgroundImage,
      width,
      height
    );
  }

  if (
    state.backgroundMode ===
    "color"
  ) {
    outputCtx.fillStyle =
      backgroundColor?.value ||
      "#d9eafa";

    outputCtx.fillRect(
      0,
      0,
      width,
      height
    );
  }

  outputCtx.drawImage(
    personCanvas,
    0,
    0
  );

  mentorAICanvas.style.display =
    "block";

  requestRender();
}


/* =========================================================
   BACKGROUND IMAGE
   ========================================================= */

function handleBackgroundImageUpload(event) {
  const file = event.target.files?.[0];

  if (!file) return;

  if (!file.type.startsWith("image/")) {
    showToast(
      "Please select an image."
    );
    return;
  }

  revokeUrl(
    state.backgroundObjectUrl
  );

  const url =
    URL.createObjectURL(file);

  state.backgroundObjectUrl = url;

  const img = new Image();

  img.onload = () => {
    state.backgroundImage = img;
    state.backgroundMode = "image";

    updateBackgroundButtons();
    startSegmentationLoop();

    showToast(
      "Custom background applied."
    );
  };

  img.src = url;
}


/* =========================================================
   BACKGROUND MODES
   ========================================================= */

async function setBackgroundMode(mode) {
  if (
    mode === "remove" ||
    mode === "blur" ||
    mode === "image" ||
    mode === "color"
  ) {
    const ready =
      await initializeSegmentation();

    if (!ready) return;

    if (!state.cameraStream) {
      showToast(
        "Start the camera first."
      );
      return;
    }

    state.backgroundMode = mode;

    mentorAICanvas.style.display =
      "block";

    startSegmentationLoop();
  } else {
    state.backgroundMode =
      "original";

    mentorAICanvas.style.display =
      "none";
  }

  updateBackgroundButtons();
  requestRender();
}


function updateBackgroundButtons() {
  const buttons = [
    bgOriginalBtn,
    bgRemoveBtn,
    bgBlurBtn,
    bgImageBtn,
    bgColorBtn
  ];

  buttons.forEach((button) => {
    if (!button) return;

    button.classList.remove(
      "active"
    );
  });

  const map = {
    original: bgOriginalBtn,
    remove: bgRemoveBtn,
    blur: bgBlurBtn,
    image: bgImageBtn,
    color: bgColorBtn
  };

  map[state.backgroundMode]
    ?.classList.add("active");
}


/* =========================================================
   COVER IMAGE
   ========================================================= */

function drawCoverImage(
  ctx,
  image,
  width,
  height
) {
  if (!image) return;

  const imageRatio =
    image.width / image.height;

  const canvasRatio =
    width / height;

  let drawWidth = width;
  let drawHeight = height;

  let x = 0;
  let y = 0;

  if (
    imageRatio > canvasRatio
  ) {
    drawHeight = height;
    drawWidth =
      height * imageRatio;

    x =
      (width - drawWidth) / 2;
  } else {
    drawWidth = width;
    drawHeight =
      width / imageRatio;

    y =
      (height - drawHeight) / 2;
  }

  ctx.drawImage(
    image,
    x,
    y,
    drawWidth,
    drawHeight
  );
}


/* =========================================================
   DRAG MENTOR
   ========================================================= */

function initializeDrag() {
  if (!mentorCard) return;

  on(
    mentorCard,
    "pointerdown",
    startMentorDrag
  );

  on(
    window,
    "pointermove",
    moveMentorDrag
  );

  on(
    window,
    "pointerup",
    stopMentorDrag
  );
}


function startMentorDrag(event) {
  if (
    event.target === mentorResize
  ) {
    return;
  }

  if (
    event.target.closest(
      "button, input, textarea, select"
    )
  ) {
    return;
  }

  state.drag.active = true;

  const rect =
    mentorCard.getBoundingClientRect();

  state.drag.startX =
    event.clientX;

  state.drag.startY =
    event.clientY;

  state.drag.originalLeft =
    rect.left;

  state.drag.originalTop =
    rect.top;

  mentorCard.setPointerCapture?.(
    event.pointerId
  );

  mentorCard.classList.add(
    "dragging"
  );
}


function moveMentorDrag(event) {
  if (!state.drag.active) {
    return;
  }

  const dx =
    event.clientX -
    state.drag.startX;

  const dy =
    event.clientY -
    state.drag.startY;

  const stageRect =
    stage.getBoundingClientRect();

  const cardRect =
    mentorCard.getBoundingClientRect();

  let left =
    state.drag.originalLeft +
    dx -
    stageRect.left;

  let top =
    state.drag.originalTop +
    dy -
    stageRect.top;

  const maxLeft =
    stageRect.width -
    cardRect.width;

  const maxTop =
    stageRect.height -
    cardRect.height;

  left = Math.max(
    0,
    Math.min(maxLeft, left)
  );

  top = Math.max(
    0,
    Math.min(maxTop, top)
  );

  mentorCard.style.left =
    `${left}px`;

  mentorCard.style.top =
    `${top}px`;

  mentorCard.style.right =
    "auto";

  mentorCard.style.bottom =
    "auto";

  requestRender();
}


function stopMentorDrag() {
  if (!state.drag.active) {
    return;
  }

  state.drag.active = false;

  mentorCard?.classList.remove(
    "dragging"
  );

  saveMentorPosition();
}


function saveMentorPosition() {
  if (!mentorCard) return;

  const data = {
    left: mentorCard.style.left,
    top: mentorCard.style.top,
    width: mentorCard.style.width,
    height: mentorCard.style.height
  };

  try {
    localStorage.setItem(
      "courseStudioMentorPosition",
      JSON.stringify(data)
    );
  } catch (error) {
    console.warn(
      "Mentor position save failed:",
      error
    );
  }
}


function restoreMentorPosition() {
  try {
    const saved =
      localStorage.getItem(
        "courseStudioMentorPosition"
      );

    if (!saved) return;

    const data =
      JSON.parse(saved);

    if (data.left) {
      mentorCard.style.left =
        data.left;
    }

    if (data.top) {
      mentorCard.style.top =
        data.top;
    }

    if (data.width) {
      mentorCard.style.width =
        data.width;
    }

    if (data.height) {
      mentorCard.style.height =
        data.height;
    }
  } catch (error) {
    console.warn(
      "Mentor position restore failed:",
      error
    );
  }
}


